/dts-v1/;

/* =========================================================================
 * BaseOS test board C: QEMU virt, cortex-a53, 512 MB, GICv2
 *
 * QEMU options:  -M virt -cpu cortex-a53 -smp 1 -m 512M
 *   one disk:    -drive if=none,file=build/ssd.img,format=raw,id=hd0
 *                -device virtio-blk-device,drive=hd0        (slot 0x0a003e00)
 *
 * Interrupt controllers (both enabled, neither has child nodes):
 *   gic  : arm,cortex-a15-gic   REAL      3 interrupt cells
 *   vic0 : arm,pl190-vic        FICTIONAL 1 interrupt cell, cascaded into gic
 *
 * Storage controllers (both enabled, different types, different parents):
 *   virtio_block@a003e00 : virtio,mmio   REAL       parent = vic0
 *   ahci@b020000         : generic-ahci  FICTIONAL  parent = gic
 *
 * Only virtio exists in QEMU. The kernel must NOT run an SSD driver for the
 * AHCI node; touching 0x0b020000 will fault. Driver selection by compatible
 * must skip any controller that has no registered driver.
 * ========================================================================= */

/memreserve/ 0x0000000040000000 0x0000000000100000;  /* DTB + early boot */
/memreserve/ 0x0000000040100000 0x0000000000100000;  /* TF-A BL31 */
/memreserve/ 0x0000000040200000 0x0000000001000000;  /* OP-TEE */

/ {
    #address-cells = <2>;
    #size-cells = <2>;
    model = "ARM Cortex-A53 Reference Platform C (two ICs, two SSD types)";
    compatible = "arm,cortex-a53-virt", "arm,vexpress";

    interrupt-parent = <&gic>;

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-a53";
            reg = <0>;
        };
    };

    memory@40000000 {
        device_type = "memory";
        reg = <0x00000000 0x40000000 0x00000000 0x20000000>;
    };

    /* ---------------- INTERRUPT CONTROLLERS ---------------- */

    /* IC 0: GICv2. reg[0] = GICD, reg[1] = GICC. 3 interrupt cells. */
    gic: interrupt-controller@8000000 {
        compatible = "arm,cortex-a15-gic";
        #interrupt-cells = <3>;
        interrupt-controller;
        reg = <0x00000000 0x08000000 0x00000000 0x00010000>,   /* GICD */
              <0x00000000 0x08010000 0x00000000 0x00010000>;   /* GICC */
    };

    /* IC 1: PL190 VIC. 1 interrupt cell. Its single output line goes into
     * the GIC as SPI 100 (interrupt-parent + interrupts below). */
    vic0: interrupt-controller@b000000 {
        compatible = "arm,pl190-vic";
        reg = <0x00000000 0x0b000000 0x00000000 0x00001000>;
        interrupt-controller;
        #interrupt-cells = <1>;
        interrupt-parent = <&gic>;
        interrupts = <0 100 4>;
    };

    /* ---------------- OTHER PERIPHERALS ---------------- */

    timer {
        compatible = "arm,armv8-timer";
        interrupts = <1 13 0x104>,
                     <1 14 0x104>,
                     <1 11 0x104>,
                     <1 10 0x104>;
        always-on;
    };

    pl011@9000000 {                       /* console UART, SPI 1, REAL */
        compatible = "arm,pl011", "arm,primecell";
        reg = <0x00000000 0x09000000 0x00000000 0x00001000>;
        interrupts = <0 1 4>;
    };

    rtc@9010000 {                         /* PL031 RTC, SPI 2, REAL */
        compatible = "arm,pl031", "arm,primecell";
        reg = <0x00000000 0x09010000 0x00000000 0x00001000>;
        interrupts = <0 2 4>;
    };

    /* ---------------- STORAGE CONTROLLERS ---------------- */

    /* SSD A: virtio-mmio block, parent = VIC (1 cell), REAL */
    virtio_block@a003e00 {
        compatible = "virtio,mmio";
        reg = <0x00000000 0x0a003e00 0x00000000 0x00000200>;
        interrupt-parent = <&vic0>;
        interrupts = <3>;
    };

    /* SSD B: AHCI SATA controller, parent = GIC (3 cells), FICTIONAL */
    ahci@b020000 {
        compatible = "generic-ahci";
        reg = <0x00000000 0x0b020000 0x00000000 0x00001000>;
        interrupt-parent = <&gic>;
        interrupts = <0 102 4>;
    };

    /* ---------------- RESERVED MEMORY ---------------- */
    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        dma_pool@42000000 {
            compatible = "shared-dma-pool";
            reg = <0x00000000 0x42000000 0x00000000 0x00800000>;
            reusable;
        };

        framebuffer@5e000000 {
            reg = <0x00000000 0x5e000000 0x00000000 0x02000000>;
            no-map;
        };

        ramoops@5fe00000 {
            compatible = "ramoops";
            reg = <0x00000000 0x5fe00000 0x00000000 0x00200000>;
            record-size = <0x00040000>;
            console-size = <0x00040000>;
        };
    };
};